{
  "expo": {
    "name": "Recauda",
    "slug": "frontend-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "com.carlosg.appalcancias",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.carlosg.appalcancias",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A242B",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "694d93c8-e691-4943-88e1-b6672393927b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/694d93c8-e691-4943-88e1-b6672393927b"
    }
  }
}
